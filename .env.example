# Firebase web config. Copy to `.env` and fill in from the Firebase console
# (Project settings → your web app). These values are not secrets — Firebase web
# config is safe to expose; access is enforced by Firestore security rules — but
# keeping them in .env makes it easy to point the app at a different project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Riot API key — server-side only (no VITE_ prefix). Dev key from
# https://developer.riotgames.com (expires every 24h). Restart dev server after editing.
RIOT_API_KEY=
